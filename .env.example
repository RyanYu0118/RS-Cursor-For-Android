# Auto reads credentials from the environment or from the telegram-notify
# skill's auth.json. Everything here is optional.

# Telegram bot to control Auto with. Without these the web app still works.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Port for the host (default 4331).
# AUTO_PORT=4331

# How sessions answer the agent's permission requests:
#   auto         approve everything (yolo, the default)
#   ask-on-write approve reads, ask before writes and commands
#   ask          ask every time
# A session whose policy you change by hand keeps that choice.
# Warning: `auto` means the phone can let the agent run commands on this PC.
# Use ask-on-write on a shared machine.
AUTO_POLICY=auto

# Which agent new sessions drive: `cursor` (default) or `opencode`.
# cursor sessions prefer a chat in the Cursor window and fall back to
# `cursor-agent acp`; opencode sessions are Auto-only, over `opencode acp`.
# The web's New session sheet and Telegram's /new can override this per session.
# opencode must be on PATH (or set OPENCODE_BIN). Existing sessions keep the
# agent they were started with.
AUTO_AGENT=cursor
# OPENCODE_BIN=C:\path\to\opencode.exe

# URL shown by /web in Telegram — set this to `tailscale ip -4`.
# AUTO_WEB_URL=http://100.x.y.z:4331

# Set to 0 to run without the Telegram poller. Only one host may poll.
# AUTO_TELEGRAM=1

# Allow Auto to force-quit Cursor when it is running without
# --remote-debugging-port=9222, then restart it with the port.
# Off by default: that kill closes every Cursor window.
# AUTO_ALLOW_CURSOR_RESTART=1

# Shell used for terminals (default powershell.exe on Windows).
# AUTO_SHELL=powershell.exe

# Run the controllable browser headless. Off by default: a headed window
# parked off-screen trips far fewer bot checks.
# AUTO_BROWSER_HEADLESS=1
